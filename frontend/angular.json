{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": { "analytics": false },
  "newProjectRoot": "projects",
  "projects": {
    "sam-ng": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src/app-ng",
      "prefix": "sam",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:browser",
          "options": {
            "outputPath": "src/ng",
            "index": { "input": "src/app-ng/index.stub.html", "output": "index.unused.html" },
            "main": "src/app-ng/main.ts",
            "polyfills": ["zone.js"],
            "tsConfig": "tsconfig.app.json",
            "assets": [],
            "styles": [],
            "scripts": [],
            "outputHashing": "none",
            "vendorChunk": false,
            "extractLicenses": false,
            "deleteOutputPath": false
          },
          "configurations": {
            "production": {
              "budgets": [
                { "type": "initial", "maximumWarning": "1mb", "maximumError": "2mb" }
              ],
              "optimization": true,
              "sourceMap": false,
              "namedChunks": false
            },
            "development": {
              "optimization": false,
              "sourceMap": true,
              "namedChunks": true
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "polyfills": ["zone.js", "zone.js/testing"],
            "tsConfig": "tsconfig.spec.json",
            "karmaConfig": "src/app-ng/karma.conf.js",
            "assets": [],
            "styles": [],
            "scripts": []
          }
        }
      }
    }
  }
}
